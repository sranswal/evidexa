# Application Configuration
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Data & Persistence
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db

# File Ingestion Safeguards
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
ALLOWED_MEDIA_TYPES=application/pdf,image/png,image/jpeg,image/tiff

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

